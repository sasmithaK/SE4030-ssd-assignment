# Backend Environment Variables Example
# Copy this file to '.env' in the backend directory before running the application.
# Do not commit your actual '.env' file containing real secrets to version control!

# MongoDB connection string for the restaurant-management-service
# Replace with your actual MongoDB Atlas URI or local MongoDB connection string
MONGODB_URI=mongodb+srv://<your_user>:<your_password>@<your_cluster_url>/

# Root password for the MySQL database used by order and delivery services
MYSQL_ROOT_PASSWORD=root

# Google OAuth2 Credentials (Member A Infrastructure Setup)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
 
# JWT Secrets
JWT_SECRET_KEY=your_secure_256_bit_secret_key_here

# OAuth2 Redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:8082/login/oauth2/code/google
APP_FRONTEND_OAUTH_REDIRECT_URL=http://localhost:3000/oauth2/redirect
